TUSHARE_TOKEN=<your_tushare_token>

# storage backend: sqlite (default, zero daemon) or mysql
DB_DRIVER=sqlite
DB_SQLITE_PATH=/home/application/tushare_stock_data/data/stock.db
# DB_DRIVER=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=<mysql_password>
# MYSQL_DATABASE=stock
# MYSQL_CHARSET=utf8mb4
# MYSQL_CONNECT_TIMEOUT=10

# sync windows
SYNC_BATCH_SIZE=5000
SYNC_RETRY_TIMES=3
SYNC_RETRY_BACKOFF_SECONDS=2
SYNC_REQUEST_INTERVAL_SECONDS=0.35
SYNC_LOOKBACK_DAYS=5
FINANCE_LOOKBACK_DAYS=30

# fallback crawlers (eastmoney etc.) when tushare returns empty / fails
ENABLE_FALLBACK=true
CRAWLER_SLEEP_MIN_SECONDS=1.5
CRAWLER_SLEEP_MAX_SECONDS=3.0
CRAWLER_MAX_RETRIES=3
CRAWLER_COOLDOWN_SECONDS=300
CRAWLER_TIMEOUT_SECONDS=20

# feishu notification for sync failures (optional; falls back to ~/.qwenpaw/config.json)
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_OPEN_ID=